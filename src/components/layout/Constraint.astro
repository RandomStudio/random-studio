---
type Props = {
  class?: string;
  type?: "constrained" | "full";
};

const { class: className, type = "constrained", ...rest } = Astro.props;
---

<div class:list={[className, "constraint", type]} {...rest}>
  <slot />
</div>

<style>
  .constraint {
    margin-inline: auto;
    width: 100%;
  }

  .constrained {
    max-width: 1440px;
    overflow: hidden;
  }
</style>

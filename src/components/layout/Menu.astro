---
import RIcon from "../../icons/r.svg";

const categories = [
  { name: "All", image: "/project/nav_01.png" },
  { name: "Applied Innovation", image: "/project/nav_03.png" },
  { name: "Experiential Retail", image: "/project/nav_02.png" },
  { name: "Exhibition & Events", image: "/project/nav_04.png" },
];

const connect = ["Newsletter", "Instagram", "LinkedIn", "Medium"];
const emails = ["Business", "Press", "Studio", "Vendors"];
---

<random-menu class="menu" data-view="navigation">
  <div class="logo"><RIcon /></div>
  <div class="panel">
    <div class="collapsible expander">
      <div class="clip">
        <div class="collapsible preview-expander">
          <div class="clip preview">
            {
              categories.map((category, index) => (
                <img
                  alt=""
                  src={category.image}
                  data-category={index}
                  class:list={[{ isActive: index === 0 }]}
                />
              ))
            }
          </div>
        </div>
        <div class="views">
          <div class="collapsible view-expander" data-for="navigation work">
            <div class="clip">
              <div class="view view--navigation">
                <div class="row">
                  <button type="button" class="item" data-target="search">
                    Search
                  </button>
                  <button type="button" class="item" data-target="contact">
                    Contact
                  </button>
                </div>
                <div class="global">
                  <ul class="primary">
                    <li>
                      <button type="button" class="item" data-target="work">
                        Work
                      </button>
                    </li>
                    <li><span class="item">News</span></li>
                    <li><a class="item" href="#">About</a></li>
                  </ul>
                  <ul class="secondary">
                    {
                      categories.map((category, index) => (
                        <li>
                          <a
                            class:list={["item", { isActive: index === 0 }]}
                            href="#"
                            data-category={index}
                          >
                            {category.name}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div class="collapsible view-expander" data-for="search">
            <div class="clip">
              <form class="view view--search" role="search">
                <input
                  class="search-input"
                  type="text"
                  name="q"
                  placeholder="Type Here"
                  aria-label="Search"
                  autocomplete="off"
                />
                <button type="submit" class="item">Search</button>
              </form>
            </div>
          </div>
          <div class="collapsible view-expander" data-for="contact">
            <div class="clip">
              <div class="view view--contact">
                <div class="group">
                  <div class="block">
                    <p class="heading">Connect</p>
                    <div class="content">
                      {
                        connect.map((name) => (
                          <a class="external" href="#">
                            {name}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                  <div class="block">
                    <p class="heading">Emails</p>
                    <div class="content">
                      {
                        emails.map((name) => (
                          <a class="external" href="#">
                            {name}
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </div>
                <div class="group">
                  <div class="block">
                    <p class="heading">Amsterdam</p>
                    <div class="content">
                      <p>
                        Gillis van Ledenberchstraat 112<br />
                        1052 VK Amsterdam<br />
                        The Netherlands<br />
                        +31 20 779 7735
                      </p>
                      <a class="external" href="#">Map</a>
                    </div>
                  </div>
                  <div class="block">
                    <p class="heading">Paris</p>
                    <div class="content">
                      <p>
                        174 Quai de Jemmapes<br />
                        75010 Paris France<br />
                        +33 1 40 36 41 44
                      </p>
                      <a class="external" href="#">Map</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <button type="button" class="label">
      <span class="label-text label-text--menu">Menu</span>
      <span class="label-text label-text--close">Close</span>
      <span class="label-text label-text--back">Back</span>
    </button>
  </div>
</random-menu>

<script>
  type View = "navigation" | "work" | "search" | "contact";

  const VIEWS: View[] = ["navigation", "work", "search", "contact"];

  // Views reached from the main menu that the label steps back out of
  const SUB_VIEWS: View[] = ["search", "contact"];

  const isView = (value: string | undefined): value is View =>
    VIEWS.includes(value as View);

  class Menu extends HTMLElement {
    #abort: AbortController | undefined;

    connectedCallback() {
      this.#abort = new AbortController();
      const { signal } = this.#abort;

      // Touch devices open from a tap on the label instead of hover
      this.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType === "mouse") {
            this.#open();
          }
        },
        { signal },
      );
      // Only keyboard focus opens it, otherwise mousedown on "Menu" would
      // open the menu and the click that follows would close it again
      this.addEventListener(
        "focusin",
        (event) => {
          if ((event.target as Element).matches(":focus-visible")) {
            this.#open();
          }
        },
        { signal },
      );
      // Once open, the menu stays open until something outside it is clicked
      document.addEventListener(
        "click",
        (event) => {
          if (!this.contains(event.target as Node)) {
            this.#close();
          }
        },
        { signal },
      );
      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            this.#close();
          }
        },
        { signal },
      );
      this.addEventListener("click", (event) => this.#onClick(event), {
        signal,
      });
      this.addEventListener("mouseover", (event) => this.#onHover(event), {
        signal,
      });
      // No search backend in the mockup yet
      this.addEventListener("submit", (event) => event.preventDefault(), {
        signal,
      });
    }

    disconnectedCallback() {
      this.#abort?.abort();
      this.#abort = undefined;
    }

    get #isOpen() {
      return this.hasAttribute("data-open");
    }

    #open() {
      if (this.#isOpen) {
        return;
      }

      this.#setView("navigation");
      this.toggleAttribute("data-open", true);
    }

    #close() {
      // The current view stays rendered so it collapses with the panel
      this.removeAttribute("data-open");
    }

    #setView(view: View) {
      this.dataset.view = view;

      if (view === "search") {
        this.querySelector<HTMLInputElement>(".search-input")?.focus();
      }
    }

    #onClick(event: MouseEvent) {
      const target = event.target as HTMLElement;
      const trigger = target.closest<HTMLElement>("[data-target]");

      if (trigger && isView(trigger.dataset.target)) {
        this.#setView(trigger.dataset.target);
        return;
      }

      if (!target.closest(".label")) {
        return;
      }

      if (!this.#isOpen) {
        this.#open();
      } else if (SUB_VIEWS.includes(this.dataset.view as View)) {
        this.#setView("navigation");
      } else {
        this.#close();
      }
    }

    #onHover(event: MouseEvent) {
      const link = (event.target as HTMLElement).closest<HTMLElement>(
        ".secondary [data-category]",
      );

      if (!link) {
        return;
      }

      for (const element of this.querySelectorAll<HTMLElement>(
        "[data-category]",
      )) {
        element.classList.toggle(
          "isActive",
          element.dataset.category === link.dataset.category,
        );
      }
    }
  }

  if (!customElements.get("random-menu")) {
    customElements.define("random-menu", Menu);
  }
</script>

<style>
  .menu {
    --timing: var(--transition-duration) var(--transition-easing);

    position: fixed;
    z-index: 1000;
    bottom: calc(2vh + 56px);
    left: 50%;
    transform: translateX(-50%);

    display: flex;
    flex-direction: row;
    align-items: flex-end;
  }
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 39px;
    background-color: black;
  }
  .panel {
    @mixin h3;
    /* Figma Type/Heading-3 is 12px, smaller than the shared h3 mixin */
    font-size: 12px;
    width: 270px;
    background-color: var(--color-foreground);
  }

  /*
   * Everything that grows or shrinks uses the same grid row trick: a single
   * row animating between 0fr and 1fr, with a clipping child inside. Content
   * fades with the same timing, and visibility flips at the end of a hide so
   * collapsed content can't be tabbed into.
   */
  .collapsible {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--timing),
      opacity var(--timing),
      margin-bottom var(--timing),
      visibility 0s var(--transition-duration);
  }
  .menu[data-open] .expander,
  .menu[data-view="work"] .preview-expander,
  .menu[data-view="navigation"] [data-for~="navigation"],
  .menu[data-view="work"] [data-for~="work"],
  .menu[data-view="search"] [data-for~="search"],
  .menu[data-view="contact"] [data-for~="contact"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows var(--timing),
      opacity var(--timing),
      margin-bottom var(--timing),
      visibility 0s;
  }
  .clip {
    min-height: 0;
    overflow: hidden;
  }

  .menu[data-view="work"] .preview-expander {
    margin-bottom: -5px;
  }
  .preview {
    display: grid;

    img {
      aspect-ratio: 210 / 152;
      grid-area: 1 / 1;
      object-fit: cover;
      opacity: 0;
      transition: opacity var(--timing);
    }

    img.isActive {
      opacity: 1;
    }
  }
  .views {
    position: relative;
    background-color: var(--color-foreground);
  }
  .view {
    padding: var(--spacing-15);
  }
  .view--navigation {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-30);
  }
  .row {
    display: flex;
    justify-content: space-between;
  }
  .global {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gutter);
  }
  .primary,
  .secondary {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
  }
  /* Always takes up space so the panel height doesn't jump when Work opens */
  .secondary {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--timing),
      visibility 0s var(--transition-duration);
  }
  .menu[data-view="work"] .secondary {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--timing),
      visibility 0s;
  }
  .item {
    padding: 0;
    border: 0;
    background: none;
    color: black;
    font: inherit;
    text-align: left;
    white-space: nowrap;
    text-box: trim-both cap alphabetic;
    transition: color var(--timing);
  }
  button.item,
  a.item {
    cursor: pointer;
  }
  /* In the work view everything but the current path fades back */
  .menu[data-view="work"] .item {
    color: var(--color-link);

    &[data-target="work"],
    &.isActive,
    &:hover {
      color: black;
    }
  }
  .view--search {
    display: flex;
    justify-content: space-between;
    gap: var(--gutter);

    .item {
      color: var(--color-link);

      &:hover {
        color: black;
      }
    }
  }
  .search-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: black;
    outline: none;

    &::placeholder {
      color: black;
    }
  }
  .view--contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gutter);
    row-gap: var(--spacing-30);
  }
  .group,
  .block {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }
  .group {
    row-gap: var(--spacing-15);
  }
  .content {
    display: flex;
    flex-direction: column;
  }
  .external {
    transition: color var(--timing);

    &::after {
      margin-left: 0.25em;
      content: "↗";
    }
  }
  .label {
    display: grid;
    align-items: center;
    justify-items: start;
    width: 100%;
    height: 38px;
    padding: 0 var(--spacing-15);
    border: 0;
    background: none;
    color: black;
    font: inherit;
    cursor: pointer;
    transition: color var(--timing);
  }
  .menu[data-open] .label {
    color: var(--color-link);

    &:hover {
      color: black;
    }
  }
  /* The three words are stacked and cross-fade as the state changes */
  .label-text {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    text-box: trim-both cap alphabetic;
    transition:
      opacity var(--timing),
      visibility 0s var(--transition-duration);
  }
  .menu:not([data-open]) .label-text--menu,
  .menu[data-open]:is([data-view="navigation"], [data-view="work"])
    .label-text--close,
  .menu[data-open]:is([data-view="search"], [data-view="contact"])
    .label-text--back {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--timing),
      visibility 0s;
  }
</style>

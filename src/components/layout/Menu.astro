---
import RIcon from "../../icons/r.svg";
---

<div class="menu">
  <div class="logo"><RIcon /></div>
  <div class="label">Menu</div>
</div>

<style>
  .menu {
    position: fixed;
    z-index: 1000;
    bottom: calc(2vh + 56px);
    left: 50%;
    transform: translateX(-50%);

    display: flex;
    flex-direction: row;
    align-items: flex-end;
  }
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 39px;
    background-color: black;
  }
  .label {
    @mixin h3;
    display: flex;
    align-items: center;
    width: 270px;
    height: 38px;
    padding-left: 25px;
    background-color: var(--color-foreground);
  }
</style>

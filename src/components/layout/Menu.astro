---
import Constraint from "./Constraint.astro";
---

<Constraint class="outer">
  <div class="inner">Random Studio</div>
</Constraint>

<style>
  .outer {
    position: fixed;
    z-index: 1000;
    bottom: calc(2vh + 56px);
    left: calc((100vw - var(--max-width)) / 2);

    display: grid;
    grid-template-columns: repeat(20, 1fr);
  }
  .inner {
    @mixin h3;
    text-align: center;
    padding: var(--spacing-15) var(--gutter);
    background-color: var(--color-foreground);
    grid-column: 9 / span 4;
  }
</style>

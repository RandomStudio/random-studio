---
import Constraint from "./Constraint.astro";
import DownloadIcon from "../../icons/download.svg";
---

<Constraint class="outer" type="full">
  <div class="mode">
    Mode
    <ul id="mode-toggle">
      <li data-mode="normal" class="isActive">
        Full
      </li>
      <li data-mode="image">Images</li>
      <li data-mode="text">Text</li>
    </ul>
  </div>
  <h1 class="title">Past and Future fabrics exhibition for Zara</h1>
  <div class="presskit">
    <a href="#">Assets [23,35mb]</a>
    <DownloadIcon />
  </div>
</Constraint>
<script>
  import { SECTION_NAV_SHRINK_TYPE } from "../project/sectionNavTransitionTypes";

  type Mode = "normal" | "text" | "image";

  const MODE_CLASSES: Record<Mode, string | null> = {
    normal: null,
    text: "mode--text-only",
    image: "mode--image-only",
  };

  const PAGE_HIDDEN_CLASS = "isPageHidden";
  const NAV_GROW_START_FRACTION = 0.75;

  const pageFadeDuration = parseFloat(
    getComputedStyle(document.documentElement).getPropertyValue(
      "--page-fade-duration",
    ),
  );
  const navGrowDelay = pageFadeDuration * NAV_GROW_START_FRACTION;

  const toggle = document.getElementById("mode-toggle");

  let pendingStep: ReturnType<typeof setTimeout> | undefined;

  const getActiveMode = () =>
    toggle?.querySelector<HTMLLIElement>("li.isActive")?.dataset.mode as
      Mode | undefined;

  const applyModeClass = (mode: Mode) => {
    for (const [classMode, className] of Object.entries(MODE_CLASSES)) {
      if (className) {
        document.body.classList.toggle(className, classMode === mode);
      }
    }
  };

  const setIsPageHidden = (isHidden: boolean) => {
    document.body.classList.toggle(PAGE_HIDDEN_CLASS, isHidden);
  };

  const enterImageMode = () => {
    setIsPageHidden(true);
    pendingStep = setTimeout(() => {
      document.startViewTransition(() => applyModeClass("image"));
    }, navGrowDelay);
  };

  const leaveImageMode = (mode: Mode) => {
    document.startViewTransition({
      update: () => applyModeClass(mode),
      types: [SECTION_NAV_SHRINK_TYPE],
    });
    pendingStep = setTimeout(() => setIsPageHidden(false), navGrowDelay);
  };

  const transitionToMode = (mode: Mode, previousMode?: Mode) => {
    clearTimeout(pendingStep);

    if (mode === "image") {
      enterImageMode();
    } else if (previousMode === "image") {
      leaveImageMode(mode);
    } else {
      document.startViewTransition(() => applyModeClass(mode));
    }
  };

  const handleModeClick = (event: MouseEvent) => {
    const item = (event.target as HTMLElement).closest<HTMLLIElement>(
      "li[data-mode]",
    );
    const mode = item?.dataset.mode as Mode | undefined;
    const activeMode = getActiveMode();

    if (!item || !mode || !(mode in MODE_CLASSES) || mode === activeMode) {
      return;
    }

    transitionToMode(mode, activeMode);

    for (const li of toggle!.querySelectorAll("li[data-mode]")) {
      li.classList.toggle("isActive", li === item);
    }
  };

  toggle?.addEventListener("click", handleModeClick);
</script>

<style>
  .outer {
    @mixin h3;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: calc((100vw - var(--max-width)) / 2);
    width: var(--max-width);
    max-width: var(--max-width);
    padding: 1em 0;
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    align-items: start;

    svg {
      display: inline-block;
      height: 1cap;
      width: auto;
    }
  }
  .mode {
    grid-column: 1 / span 5;
    text-align: left;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;

    ul {
      display: flex;
      flex-direction: row;
      gap: 0.5em;
    }

    li {
      position: relative;
      color: var(--color-link);
      cursor: pointer;

      &::before {
        margin-right: 0.25em;
        content: url("../../icons/box.svg");
      }
    }

    li.isActive {
      color: black;

      &::before {
        content: url("../../icons/bullet.svg");
      }
    }
  }
  .title {
    grid-column: 6 / span 10;
    margin: 0;
    font: inherit;
    text-align: center;
    opacity: 0;
    transition: opacity 0.2s;
  }
  /* Set on body by the page once the header title is scrolled over */
  :global(.isProjectTitleHidden) .title,
  :global(.mode--image-only) .title {
    opacity: 1;
  }
  .presskit {
    grid-column: 16 / span 5;
    text-align: right;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    color: black;

    &:hover {
      color: var(--color-link);
    }

    a {
      margin-right: 0.3em;
      color: inherit;
    }
  }
</style>

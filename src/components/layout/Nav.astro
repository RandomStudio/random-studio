---
import Constraint from "./Constraint.astro";
import AssetsDownload from "./AssetsDownload/AssetsDownload.astro";
import { projectTitle } from "../../data/project";
---

<Constraint class="outer" type="full">
  <div class="mode">
    Mode
    <ul id="mode-toggle">
      <li data-mode="normal" class="isActive">
        Full
      </li>
      <li data-mode="image">Images</li>
      <li data-mode="text">Text</li>
    </ul>
  </div>
  <h1 class="title">
    <button id="scroll-to-top" type="button">
      {projectTitle}
    </button>
  </h1>
  <div class="presskit">
    <AssetsDownload />
  </div>
  <button class="close" id="slideshow-close" type="button">
    Close
  </button>
</Constraint>
<script>
  import { MODE_CHANGE_EVENT, type Mode } from "../modeEvents";
  import { SLIDESHOW_CLOSE_EVENT } from "../slideshowState";

  const MODE_CLASSES: Record<Mode, string | null> = {
    normal: null,
    text: "mode--text-only",
    image: "mode--image-only",
  };

  const toggle = document.getElementById("mode-toggle");
  const closeButton = document.getElementById("slideshow-close");
  const scrollToTopButton = document.getElementById("scroll-to-top");

  const getActiveMode = () =>
    toggle?.querySelector<HTMLLIElement>("li.isActive")?.dataset.mode as
      Mode | undefined;

  const applyModeClass = (mode: Mode) => {
    for (const [classMode, className] of Object.entries(MODE_CLASSES)) {
      if (className) {
        document.body.classList.toggle(className, classMode === mode);
      }
    }
  };

  const announceMode = (mode: Mode) => {
    document.dispatchEvent(
      new CustomEvent(MODE_CHANGE_EVENT, { detail: mode }),
    );
  };

  const updateMode = (mode: Mode) => {
    applyModeClass(mode);
    announceMode(mode);
  };

  const markActiveToggleItem = (mode: Mode) => {
    for (const item of toggle?.querySelectorAll<HTMLLIElement>(
      "li[data-mode]",
    ) ?? []) {
      item.classList.toggle("isActive", item.dataset.mode === mode);
    }
  };

  const selectMode = (mode: Mode) => {
    const activeMode = getActiveMode();
    if (mode === activeMode) return;

    markActiveToggleItem(mode);

    if (mode === "image" || activeMode === "image") {
      updateMode(mode);
    } else {
      document.startViewTransition(() => updateMode(mode));
    }
  };

  const handleModeClick = (event: MouseEvent) => {
    const mode = (event.target as HTMLElement).closest<HTMLLIElement>(
      "li[data-mode]",
    )?.dataset.mode;

    if (mode && mode in MODE_CLASSES) {
      selectMode(mode as Mode);
    }
  };

  const handleCloseClick = () => {
    document.dispatchEvent(new Event(SLIDESHOW_CLOSE_EVENT));
  };

  const getScrollBehavior = (): ScrollBehavior =>
    matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

  const getScrollContainer = (mode: Mode | undefined) =>
    mode === "image" ? document.getElementById("image-mode") : window;

  const handleScrollToTopClick = () => {
    getScrollContainer(getActiveMode())?.scrollTo({
      top: 0,
      behavior: getScrollBehavior(),
    });
  };

  toggle?.addEventListener("click", handleModeClick);
  closeButton?.addEventListener("click", handleCloseClick);
  scrollToTopButton?.addEventListener("click", handleScrollToTopClick);
</script>

<style>
  .outer {
    @mixin h3;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: min(100%, var(--max-width));
    padding: var(--spacing-15) 0;
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    align-items: start;
  }
  .mode {
    grid-column: 1 / span 5;
    text-align: left;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;

    ul {
      display: flex;
      flex-direction: row;
      gap: 0.5em;
    }

    li {
      position: relative;
      color: var(--color-link);
      cursor: pointer;

      &::before {
        margin-right: 0.25em;
        content: url("../../icons/box.svg");
      }
    }

    li.isActive {
      color: black;

      &::before {
        content: url("../../icons/bullet.svg");
      }
    }
  }
  .title {
    grid-column: 6 / span 10;
    margin: 0;
    font: inherit;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    display: flex;
    justify-content: center;

    button {
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
    }
  }
  /* Set on body by the page once the header title is scrolled over */
  :global(.isProjectTitleHidden) .title,
  :global(.mode--image-only) .title,
  :global(.isSlideshowOpen) .title {
    opacity: 1;
    pointer-events: auto;
  }
  :global(.mode--text-only) .title {
    opacity: 0;
    pointer-events: none;
  }
  .presskit,
  .close {
    grid-column: 16 / span 5;
    grid-row: 1;
  }
  .close {
    display: none;
    justify-self: end;
    padding: 0;
    border: 0;
    background: none;
    color: black;
    cursor: pointer;

    &:hover {
      color: var(--color-link);
    }
  }
  :global(.isSlideshowOpen) {
    .presskit {
      display: none;
    }
    .close {
      display: block;
    }
  }
  .presskit {
    display: flex;
    justify-content: flex-end;
  }
</style>

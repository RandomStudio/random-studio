---
import Constraint from "./Constraint.astro";
import DownloadIcon from "../../icons/download.svg";
---

<Constraint class="outer" type="full">
  <div class="mode">
    Mode
    <ul id="mode-toggle">
      <li data-mode="normal" class="isActive">
        Full
      </li>
      <li data-mode="image">Images</li>
      <li data-mode="text">Text</li>
    </ul>
  </div>
  <h1 class="title">Past and Future fabrics exhibition for Zara</h1>
  <div class="presskit">
    <a href="#">Assets [23,35mb]</a>
    <DownloadIcon />
  </div>
  <button class="close" id="image-mode-close" type="button">
    Close
  </button>
</Constraint>
<script>
  import {
    IMAGE_MODE_CLOSE_EVENT,
    IMAGE_MODE_OPEN_EVENT,
    MODE_CHANGE_EVENT,
    type Mode,
  } from "../modeEvents";

  const MODE_CLASSES: Record<Mode, string | null> = {
    normal: null,
    text: "mode--text-only",
    image: "mode--image-only",
  };

  const toggle = document.getElementById("mode-toggle");
  const closeButton = document.getElementById("image-mode-close");

  let modeBeforeImage: Mode = "normal";

  const getActiveMode = () =>
    toggle?.querySelector<HTMLLIElement>("li.isActive")?.dataset.mode as
      Mode | undefined;

  const applyModeClass = (mode: Mode) => {
    for (const [classMode, className] of Object.entries(MODE_CLASSES)) {
      if (className) {
        document.body.classList.toggle(className, classMode === mode);
      }
    }
  };

  const announceMode = (mode: Mode) => {
    document.dispatchEvent(
      new CustomEvent(MODE_CHANGE_EVENT, { detail: mode }),
    );
  };

  const updateMode = (mode: Mode) => {
    applyModeClass(mode);
    announceMode(mode);
  };

  const markActiveToggleItem = (mode: Mode) => {
    for (const item of toggle?.querySelectorAll<HTMLLIElement>(
      "li[data-mode]",
    ) ?? []) {
      item.classList.toggle("isActive", item.dataset.mode === mode);
    }
  };

  const selectMode = (mode: Mode) => {
    const activeMode = getActiveMode();
    if (mode === activeMode) return;

    if (mode === "image" && activeMode) {
      modeBeforeImage = activeMode;
    }

    markActiveToggleItem(mode);

    if (mode === "image" || activeMode === "image") {
      updateMode(mode);
    } else {
      document.startViewTransition(() => updateMode(mode));
    }
  };

  const handleModeClick = (event: MouseEvent) => {
    const mode = (event.target as HTMLElement).closest<HTMLLIElement>(
      "li[data-mode]",
    )?.dataset.mode;

    if (mode && mode in MODE_CLASSES) {
      selectMode(mode as Mode);
    }
  };

  const handleImageModeOpen = () => selectMode("image");

  const handleImageModeClose = () => selectMode(modeBeforeImage);

  toggle?.addEventListener("click", handleModeClick);
  closeButton?.addEventListener("click", handleImageModeClose);
  document.addEventListener(IMAGE_MODE_OPEN_EVENT, handleImageModeOpen);
  document.addEventListener(IMAGE_MODE_CLOSE_EVENT, handleImageModeClose);
</script>

<style>
  .outer {
    @mixin h3;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: min(100%, var(--max-width));
    padding: var(--spacing-15) var(--gutter);
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    align-items: start;

    svg {
      display: inline-block;
      height: 1cap;
      width: auto;
    }
  }
  .mode {
    grid-column: 1 / span 5;
    text-align: left;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1em;

    ul {
      display: flex;
      flex-direction: row;
      gap: 0.5em;
    }

    li {
      position: relative;
      color: var(--color-link);
      cursor: pointer;

      &::before {
        margin-right: 0.25em;
        content: url("../../icons/box.svg");
      }
    }

    li.isActive {
      color: black;

      &::before {
        content: url("../../icons/bullet.svg");
      }
    }
  }
  .title {
    grid-column: 6 / span 10;
    margin: 0;
    font: inherit;
    text-align: center;
    opacity: 0;
    transition: opacity 0.2s;
  }
  /* Set on body by the page once the header title is scrolled over */
  :global(.isProjectTitleHidden) .title,
  :global(.mode--image-only) .title {
    opacity: 1;
  }
  .presskit,
  .close {
    grid-column: 16 / span 5;
    grid-row: 1;
  }
  .close {
    display: none;
    justify-self: end;
    padding: 0;
    border: 0;
    background: none;
    color: black;
    cursor: pointer;

    &:hover {
      color: var(--color-link);
    }
  }
  :global(.mode--image-only) {
    .presskit {
      display: none;
    }
    .close {
      display: block;
    }
  }
  .presskit {
    text-align: right;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    color: black;

    &:hover {
      color: var(--color-link);
    }

    a {
      margin-right: 0.3em;
      color: inherit;
    }
  }
</style>

---
import { Image } from "astro:assets";

type Props = {
  image: ImageMetadata;
  alt?: string;
  colSpan?: number;
  colStart?: number;
};

const { image, alt, colSpan, colStart } = Astro.props;
---

<Image
  src={image}
  alt={alt ?? ""}
  style={{ gridColumn: `${colStart} / span ${colSpan}` }}
/>

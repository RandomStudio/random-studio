---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

type Props = {
  images: string[];
  info?: {
    title: string;
    text: string[];
  };
};

const { info, images } = Astro.props;
---

<project-gallery class:list={["gallery", info && "hasInfo"]}>
  <div class="images">
    {
      images.map((image) => (
        <img class="image" src={image} alt="gallery image" />
      ))
    }
  </div>
  {
    info && (
      <div class="info">
        <p class="title">{info.title}</p>
        {info.text.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    )
  }
  <div class="overlay" hidden>
    <div class="selection"></div>
  </div>
</project-gallery>

<script>
  class ProjectGallery extends HTMLElement {
    #overlay!: HTMLElement;
    #selection!: HTMLElement;
    #hovered: HTMLImageElement | null = null;
    #controller?: AbortController;

    connectedCallback() {
      const images = this.querySelector(".images")!;
      this.#overlay = this.querySelector(".overlay")!;
      this.#selection = this.querySelector(".selection")!;

      this.#controller = new AbortController();
      const { signal } = this.#controller;

      images.addEventListener("mouseover", this.#onMouseOver, { signal });
      images.addEventListener("mouseleave", this.#onMouseLeave, { signal });
      window.addEventListener("scroll", this.#positionSelection, {
        signal,
        passive: true,
      });
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }

    #onMouseOver = ({ target }: Event) => {
      if (!(target instanceof HTMLImageElement)) return;

      this.#hovered = target;
      this.#overlay.style.backgroundImage = `url("${target.currentSrc}")`;
      this.#overlay.hidden = false;
      this.#positionSelection();
    };

    #onMouseLeave = () => {
      this.#hovered = null;
      this.#overlay.hidden = true;
    };

    #positionSelection = () => {
      if (!this.#hovered) return;

      const { top, left, width, height } = this.#hovered.getBoundingClientRect();
      Object.assign(this.#selection.style, {
        top: `${top}px`,
        left: `${left}px`,
        width: `${width}px`,
        height: `${height}px`,
      });
    };
  }

  customElements.define("project-gallery", ProjectGallery);
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    grid-column: 1 / span 20;
    gap: var(--spacing-15) var(--gutter);
    margin-block: var(--spacing-30);
    position: relative;
  }
  .images {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    grid-column: 1 / span 20;
    gap: var(--spacing-15) var(--gutter);
    height: max-content;
  }
  .image {
    --single-image: calc((100% - 4 * var(--gutter)) / 5);
    width: var(--single-image);
    object-fit: contain;
    border-radius: 5px;
  }
  .hasInfo {
    .images {
      grid-column: 1 / span 15;
    }
    .image {
      --single-image: calc((100% - 3 * var(--gutter)) / 4);
    }
  }
  .info {
    grid-column: 17 / span 4;
    @mixin body;

    :global(p:not(:last-child)) {
      margin-bottom: 1em;
    }

    .heading {
      @mixin h3;
      color: var(--color-link);
      margin-bottom: 0.5em;
    }
  }

  .overlay {
    position: fixed;
    inset: 0;
    background-color: var(--color-background);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    pointer-events: none;
    z-index: 9999;

    .selection {
      position: absolute;
      border: 1px solid var(--color-link);
      border-radius: 5px;
    }
  }

  :global(.mode--text-only) {
    .gallery {
      display: none;
    }
  }
</style>

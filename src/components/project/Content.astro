---
import Constraint from "../../components/layout/Constraint.astro";

import Gallery from "./Gallery.astro";
import TextBlock from "./TextBlock.astro";
import ProjectImage from "./ProjectImage.astro";
import ProjectVideo from "./ProjectVideo.astro";

import {
  content,
  getSectionId,
  type ContentBlock,
} from "../../data/project";

let sectionNumber = 0;

const splitContentBlocksByConstraint = (content: ContentBlock[]) => {
  const contentSplitByConstraint: {
    blocks: ContentBlock[];
    constraintType: "full" | "constrained";
  }[] = [];

  content.forEach((block) => {
    if (block.isFullWidth === false) {
      contentSplitByConstraint.push({
        blocks: [block],
        constraintType: "constrained",
      });

      return;
    }

    const lastConstraint =
      contentSplitByConstraint[contentSplitByConstraint.length - 1];

    if (!lastConstraint || lastConstraint.constraintType === "constrained") {
      contentSplitByConstraint.push({
        blocks: [block],
        constraintType: "full",
      });

      return;
    }

    lastConstraint.blocks.push(block);
  });

  return contentSplitByConstraint;
};
---

{
  splitContentBlocksByConstraint(content).map((constraint) => (
    <Constraint type={constraint.constraintType} class="grid">
      {constraint.blocks.map((block) => {
        if (block.type === "image") {
          return (
            <ProjectImage
              image={block.image}
              alt=""
              colSpan={block.colSpan}
              colStart={block.colStart}
              alignSelf={block.alignment}
            />
          );
        }

        if (block.type === "video") {
          return (
            <ProjectVideo
              src={block.image}
              colSpan={block.colSpan}
              colStart={block.colStart}
              alignSelf={block.alignment}
            />
          );
        }

        if (block.type === "text") {
          return (
            <TextBlock
              id={getSectionId(++sectionNumber)}
              title={block.title}
              colSpan={block.colSpan}
              colStart={block.colStart}
              alignSelf={block.alignment}
            >
              {block.copy.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </TextBlock>
          );
        }
        if (block.type === "gallery") {
          return <Gallery images={block.images} info={block.info} />;
        }
      })}
    </Constraint>
  ))
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    grid-template-rows: auto;
    gap: 0;
  }

  .mode--text-only {
    .header {
      height: 10svh;
    }
    :global(video) {
      display: none !important;
    }
    :global(img) {
      display: none !important;
    }
  }
</style>

---
import MoreInfo from "./MoreInfo.astro";

import type { MoreInfo as MoreInfoData } from "../../data/project";

type Props = {
  id?: string;
  colSpan: number;
  colStart: number;
  title: string;
  moreInfo?: MoreInfoData;
  alignSelf?: "start" | "center" | "end";
};

const { id, title, moreInfo, alignSelf } = Astro.props;
---

<div
  id={id}
  class="outer"
  style={{
    gridColumn: `${Astro.props.colStart} / span ${Astro.props.colSpan}`,
    alignSelf,
  }}
>
  <div class="title">{title}</div>
  <div class="copy"><slot /></div>
  {
    moreInfo && (
      <div class="more-info">
        <MoreInfo {...moreInfo} />
      </div>
    )
  }
</div>

<style>
  .outer {
    @mixin h3;
    display: grid;
    grid-template-columns: 4fr 2fr 8fr 2fr 4fr;
    grid-template-areas: "title spacer copy spacer2 moreinfo";
    gap: 16px;
    margin-top: var(--spacing-30);
    margin-bottom: var(--spacing-40);
    /* Where a section nav jump lands, relative to the heading */
    scroll-margin-top: 20vh;
  }
  .title {
    grid-area: title;
  }
  .copy {
    grid-area: copy;
    text-justify: distribute;

    :global(p:not(:last-child)) {
      margin-bottom: 1em;
    }
  }
  .more-info {
    grid-area: moreinfo;
  }

  :global(.mode--text-only) {
    .outer {
      grid-template-columns: 6fr 10fr 6fr;
      grid-template-areas:
        "spacer title spacer2"
        "spacer copy spacer2"
        "spacer moreinfo spacer2";
      margin-top: 0;
    }
    .title {
      margin-bottom: 1em;
    }
  }
  :global(.mode--image-only) {
    .outer {
      display: none;
    }
  }
</style>

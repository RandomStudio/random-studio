---
import MoreInfo from "./MoreInfo.astro";

import type { MoreInfo as MoreInfoData } from "../../data/project";

type Props = {
  id?: string;
  sectionNumber: number;
  isPageTitle?: boolean;
  colSpan: number;
  colStart: number;
  title: string;
  moreInfo?: MoreInfoData;
  alignSelf?: "start" | "center" | "end";
};

const { id, sectionNumber, isPageTitle, title, moreInfo, alignSelf } =
  Astro.props;
---

<div
  id={id}
  class:list={["outer", { hasPageTitle: isPageTitle }]}
  style={{
    gridColumn: `${Astro.props.colStart} / span ${Astro.props.colSpan}`,
    alignSelf,
    "--section-number": sectionNumber,
  }}
>
  <div class="title">{title}</div>
  <div class="copy">
    <slot />
  </div>
  {moreInfo && (
    <div class="more-info">
      <MoreInfo {...moreInfo} />
    </div>
  )}
</div>

<style>
  .outer {
    @mixin h3;
    display: grid;
    grid-template-columns: 4fr 2fr 8fr 2fr 4fr;
    grid-template-areas: "title spacer copy spacer2 moreinfo";
    gap: 16px;
    margin-top: var(--spacing-30);
    margin-bottom: var(--spacing-40);
    /* Where a section nav jump lands, relative to the heading */
    scroll-margin-top: 20vh;
  }
  .title {
    grid-area: title;
  }
  .copy {
    grid-area: copy;
    text-justify: distribute;

    :global(p:not(:last-child)) {
      margin-bottom: 1em;
    }
  }
  .more-info {
    grid-area: moreinfo;
  }

  :global(.mode--text-only) {
    counter-reset: text-section;

    .outer {
      grid-template-columns:
        1fr
        min(calc(412 * var(--type-scaled-pixel)), 100%)
        1fr;
      grid-template-areas:
        "spacer title spacer2"
        "spacer copy spacer2"
        "spacer moreinfo spacer2";
      gap: 0;
      margin-block: 0 calc(42 * var(--type-scaled-pixel));
    }
    .title {
      padding-left: calc(30 * var(--type-scaled-pixel));
      margin-bottom: calc(16 * var(--type-scaled-pixel));
      text-box: trim-both cap alphabetic;
    }
    .copy :global(p:not(:last-child)) {
      margin-bottom: calc(18.4 * var(--type-scaled-pixel));
    }
    .hasPageTitle .title {
      grid-column: 1 / -1;
      padding-left: 0;
      margin-bottom: calc(59.5 * var(--type-scaled-pixel));
      text-align: center;
    }
    .outer:not(.hasPageTitle) .title,
    .hasPageTitle .copy {
      position: relative;
      counter-increment: text-section;

      &::before {
        content: counter(text-section, lower-roman);
        position: absolute;
        left: calc(-30 * var(--type-scaled-pixel));
      }
    }
    .hasPageTitle .copy::before {
      text-box: trim-both cap alphabetic;
    }
    .more-info {
      justify-self: center;
      margin-top: calc(42 * var(--type-scaled-pixel));
    }

    @media (prefers-reduced-motion: no-preference) {
      .title,
      .copy,
      .more-info {
        animation: text-mode-reveal 0.2s ease-out backwards;
        animation-delay: calc(
          (var(--section-number) - 1) * 0.08s + var(--reveal-offset, 0s)
        );
      }
      .copy {
        --reveal-offset: 0.04s;
      }
      .more-info {
        --reveal-offset: 0.08s;
      }
    }
  }

  @keyframes text-mode-reveal {
    from {
      opacity: 0;
    }
  }
</style>

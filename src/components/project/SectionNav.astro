---
import { Image } from "astro:assets";

import {
  content,
  getSections,
  MAX_SECTION_PREVIEW_IMAGES,
} from "../../data/project";

const PREVIEW_IMAGE_HEIGHT = 318;

const sections = getSections(content);
---

<section-nav class="section-nav">
  <nav class="strip" aria-label="Sections">
    {sections.map((section) => (
      <a
        class="anchor"
        href={`#${section.id}`}
        data-section={section.id}
        title={section.title}
        style={`--images-transition-name: ${section.id}-images; --text-transition-name: ${section.id}-text`}
      >
        <div class="images">
          <div class="imageRow">
            {section.images
              .slice(0, MAX_SECTION_PREVIEW_IMAGES)
              .map((image) => (
                <Image
                  src={image}
                  alt=""
                  height={PREVIEW_IMAGE_HEIGHT}
                  loading="eager"
                  data-awaited-by-loader
                />
              ))}
          </div>
        </div>
        <div class="text">
          <p>{section.title}</p>
        </div>
      </a>
    ))}
  </nav>
</section-nav>

<script>
  // A section becomes active once its heading passes this viewport fraction
  const ACTIVE_LINE = 0.5;
  // Seconds for the compact sizes to close 63% of the gap to their target
  const EASING_TIME_CONSTANT = 0.06;
  const SETTLED_DISTANCE = 0.001;

  type CompactSizes = {
    smallWidth: number;
    smallHeight: number;
    largeHeight: number;
    gap: number;
  };

  type AnchorMetrics = { largeWidth: number; firstImageAspect: number };

  type AnchorGeometry = {
    width: number;
    height: number;
    contentLeft: number;
    contentHeight: number;
  };

  const readPixels = (element: Element, property: string) =>
    parseFloat(getComputedStyle(element).getPropertyValue(property));

  const readAspect = (image: HTMLImageElement) =>
    Number(image.getAttribute("width")) / Number(image.getAttribute("height"));

  const interpolate = (from: number, to: number, progress: number) =>
    from + (to - from) * progress;

  const easeTowards = (current: number, target: number, seconds: number) =>
    target + (current - target) * Math.exp(-seconds / EASING_TIME_CONSTANT);

  const prefersReducedMotion = () =>
    matchMedia("(prefers-reduced-motion: reduce)").matches;

  const getAnchorGeometry = (
    { smallWidth, smallHeight, largeHeight }: CompactSizes,
    { largeWidth, firstImageAspect }: AnchorMetrics,
    progress: number,
  ): AnchorGeometry => {
    const height = interpolate(smallHeight, largeHeight, progress);
    const centeringShift = Math.max(
      0,
      (firstImageAspect * smallHeight - smallWidth) / 2,
    );

    return {
      width: interpolate(smallWidth, largeWidth, progress),
      height,
      contentLeft: -interpolate(centeringShift, 0, progress),
      contentHeight: Math.max(height, smallWidth / firstImageAspect),
    };
  };

  const getLeftEdges = (geometries: AnchorGeometry[], gap: number) =>
    geometries.map((_, index) =>
      geometries
        .slice(0, index)
        .reduce((left, { width }) => left + width + gap, 0),
    );

  // The row counter-scales the box's target-to-eased scale so images stay undistorted
  const getAnchorStyle = (
    eased: AnchorGeometry,
    target: AnchorGeometry,
    anchorOffset: number,
  ) => {
    const scaleX = eased.width / target.width;
    const scaleY = eased.height / target.height;
    const contentScale = eased.contentHeight / target.height;
    const contentTop = (eased.height - eased.contentHeight) / 2;

    return {
      "--anchor-offset": `${anchorOffset}px`,
      "--images-scale-x": `${scaleX}`,
      "--images-scale-y": `${scaleY}`,
      "--image-row-left": `${eased.contentLeft / scaleX}px`,
      "--image-row-top": `${contentTop / scaleY}px`,
      "--image-row-scale-x": `${contentScale / scaleX}`,
      "--image-row-scale-y": `${contentScale / scaleY}`,
    };
  };

  const getAnchorStyles = (
    eased: AnchorGeometry[],
    targets: AnchorGeometry[],
    gap: number,
  ) => {
    const easedLefts = getLeftEdges(eased, gap);
    const targetLefts = getLeftEdges(targets, gap);

    return eased.map((geometry, index) =>
      getAnchorStyle(
        geometry,
        targets[index]!,
        easedLefts[index]! - targetLefts[index]!,
      ),
    );
  };

  const setStyleProperties = (
    element: HTMLElement,
    properties: Record<string, string>,
  ) => {
    Object.entries(properties).forEach(([name, value]) =>
      element.style.setProperty(name, value),
    );
  };

  class SectionNav extends HTMLElement {
    #strip?: HTMLElement;
    #anchors: HTMLAnchorElement[] = [];
    #targets: HTMLElement[] = [];
    #controller?: AbortController;
    #frame?: number;
    #sizes?: CompactSizes;
    #metrics: AnchorMetrics[] = [];
    #targetGeometries: AnchorGeometry[] = [];
    #activeIndex = 0;
    #progresses: number[] = [];
    #offset = 0;
    #animationFrame?: number;
    #lastFrameTime = 0;

    connectedCallback() {
      this.#strip = this.querySelector<HTMLElement>(".strip") ?? undefined;
      this.#anchors = [
        ...this.querySelectorAll<HTMLAnchorElement>(".strip [data-section]"),
      ];
      this.#targets = this.#anchors
        .map((anchor) => document.getElementById(anchor.dataset.section!))
        .filter((target): target is HTMLElement => target !== null);

      this.#controller = new AbortController();
      const { signal } = this.#controller;

      window.addEventListener("scroll", this.#scheduleUpdate, {
        signal,
        passive: true,
      });
      window.addEventListener("resize", this.#scheduleUpdate, { signal });

      this.#measure();
      this.#update();
      this.#snapToTargets();
      this.#showOnceDecoded();
    }

    disconnectedCallback() {
      this.#controller?.abort();
      if (this.#frame) cancelAnimationFrame(this.#frame);
      if (this.#animationFrame) cancelAnimationFrame(this.#animationFrame);
    }

    #measure = () => {
      if (!this.#strip) return;

      this.#sizes = {
        smallWidth: readPixels(this.#strip, "--small-width"),
        smallHeight: readPixels(this.#strip, "--small-height"),
        largeHeight: readPixels(this.#strip, "--large-height"),
        gap: parseFloat(getComputedStyle(this.#strip).columnGap),
      };

      const { largeHeight } = this.#sizes;

      this.#metrics = this.#anchors.map((anchor) => {
        const aspects = [...anchor.querySelectorAll("img")].map(readAspect);

        return {
          largeWidth: aspects.reduce(
            (width, aspect) => width + aspect * largeHeight,
            0,
          ),
          firstImageAspect: aspects[0] ?? 1,
        };
      });
    };

    #getTargetProgress = (index: number) =>
      index === this.#activeIndex ? 1 : 0;

    #getRestingOffset = () => {
      const { smallWidth, gap } = this.#sizes!;
      const activeWidth = this.#metrics[this.#activeIndex]?.largeWidth ?? 0;
      const stripWidth =
        this.#anchors.length * (smallWidth + gap) -
        gap +
        activeWidth -
        smallWidth;

      return (this.clientWidth - stripWidth) / 2;
    };

    #snapToTargets = () => {
      if (!this.#sizes) return;

      this.#progresses = this.#anchors.map((_, index) =>
        this.#getTargetProgress(index),
      );
      this.#offset = this.#getRestingOffset();
      this.#applyTargetLayout();
      this.#render();
    };

    #animate = () => {
      if (!this.#sizes || this.#animationFrame) return;

      this.#lastFrameTime = performance.now();
      this.#animationFrame = requestAnimationFrame(this.#step);
    };

    #step = (time: number) => {
      const seconds = prefersReducedMotion()
        ? Infinity
        : (time - this.#lastFrameTime) / 1000;
      this.#lastFrameTime = time;

      this.#progresses = this.#progresses.map((progress, index) =>
        easeTowards(progress, this.#getTargetProgress(index), seconds),
      );
      this.#offset = easeTowards(
        this.#offset,
        this.#getRestingOffset(),
        seconds,
      );
      this.#render();

      const isSettled =
        this.#progresses.every(
          (progress, index) =>
            Math.abs(progress - this.#getTargetProgress(index)) <
            SETTLED_DISTANCE,
        ) &&
        Math.abs(this.#offset - this.#getRestingOffset()) < SETTLED_DISTANCE;

      this.#animationFrame = isSettled
        ? undefined
        : requestAnimationFrame(this.#step);
    };

    #getGeometries = (getProgress: (index: number) => number) =>
      this.#anchors.map((_, index) =>
        getAnchorGeometry(
          this.#sizes!,
          this.#metrics[index]!,
          getProgress(index),
        ),
      );

    #applyTargetLayout = () => {
      this.#targetGeometries = this.#getGeometries(this.#getTargetProgress);

      this.#anchors.forEach((anchor, index) => {
        const { width, height } = this.#targetGeometries[index]!;

        anchor.style.setProperty("--images-width", `${width}px`);
        anchor.style.setProperty("--images-height", `${height}px`);
      });
    };

    #render = () => {
      const eased = this.#getGeometries(
        (index) => this.#progresses[index] ?? 0,
      );
      const styles = getAnchorStyles(
        eased,
        this.#targetGeometries,
        this.#sizes!.gap,
      );

      this.#strip?.style.setProperty("--strip-offset", `${this.#offset}px`);
      this.#anchors.forEach((anchor, index) =>
        setStyleProperties(anchor, styles[index]!),
      );
    };

    #showOnceDecoded = async () => {
      const images = [...this.querySelectorAll<HTMLImageElement>("img")];

      await Promise.all(
        images.map((image) => image.decode().catch(() => undefined)),
      );
      this.classList.add("isDecoded");
    };

    #scheduleUpdate = () => {
      if (this.#frame) return;

      this.#frame = requestAnimationFrame(() => {
        this.#frame = undefined;
        this.#update();
      });
    };

    #update = () => {
      const { innerHeight } = window;

      // Last section whose heading has passed the active line; the first
      // section stays active above its heading since it owns the header image
      const line = innerHeight * ACTIVE_LINE;
      let activeIndex = 0;

      this.#targets.forEach((target, index) => {
        if (target.getBoundingClientRect().top <= line) {
          activeIndex = index;
        }
      });

      const activeId = this.#targets[activeIndex]?.id;

      this.#setActiveIndex(
        Math.max(
          0,
          this.#anchors.findIndex(
            (anchor) => anchor.dataset.section === activeId,
          ),
        ),
      );
      this.#animate();
    };

    #setActiveIndex = (index: number) => {
      if (index === this.#activeIndex || !this.#sizes) return;

      this.#activeIndex = index;
      this.#applyTargetLayout();
      this.#render();
    };
  }

  customElements.define("section-nav", SectionNav);
</script>

<style>
  .section-nav {
    position: fixed;
    z-index: 999;
    top: var(--spacing-40);
    left: 0;
    right: 0;
    pointer-events: none;
    transition: opacity 0.6s;

    @media (scripting: enabled) {
      &:not(.isDecoded) {
        opacity: 0;
      }
    }
  }

  .images,
  .text {
    view-transition-class: section-nav;
  }

  .strip {
    /* Compact end states; layout snaps to them while the script eases transforms between them */
    --small-width: 28.5px;
    --small-height: 35.5px;
    --large-height: 71px;
    --images-radius: 5px;
    display: flex;
    gap: var(--spacing-5);
    padding: var(--spacing-15);
    overflow-x: auto;
    scrollbar-width: none;
    pointer-events: auto;

    .anchor {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-10);
      flex-shrink: 0;
    }

    .images {
      height: 159px;
      border-radius: var(--images-radius);
      overflow: hidden;
      view-transition-name: var(--images-transition-name);
    }

    .imageRow {
      display: flex;
      height: 100%;
    }

    img {
      flex-shrink: 0;
      height: 100%;
      width: auto;
      max-width: none;
      object-fit: cover;
    }

    .text {
      @mixin body;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-5);
      color: black;
      max-width: 70%;
      white-space: nowrap;
      view-transition-name: var(--text-transition-name);
      transition: opacity 0.2s;
    }

    &:has(.anchor:hover) .anchor:not(:hover) .text {
      opacity: 0.3;
    }
  }

  :global(.isProjectTitleHidden) .strip {
    position: absolute;
    top: 0;
    left: 0;
    translate: var(--strip-offset, calc(50vw - 50%)) 0;
    align-items: flex-start;
    padding: 0;
    overflow: visible;

    .anchor {
      translate: var(--anchor-offset, 0) 0;
    }

    .images {
      width: var(--images-width, var(--small-width));
      height: var(--images-height, var(--small-height));
      transform-origin: 0 0;
      scale: var(--images-scale-x, 1) var(--images-scale-y, 1);
      border-radius: calc(var(--images-radius) / var(--images-scale-x, 1)) /
        calc(var(--images-radius) / var(--images-scale-y, 1));
    }

    .imageRow {
      transform-origin: 0 0;
      translate: var(--image-row-left, 0) var(--image-row-top, 0);
      scale: var(--image-row-scale-x, 1) var(--image-row-scale-y, 1);
    }

    .text {
      display: none;
    }
  }

  :global(html:has(section-nav)) {
    scroll-behavior: smooth;
  }

  :global(::view-transition-group(*.section-nav)) {
    animation-duration: 0.3s;
    border-radius: 5px;
    overflow: hidden;
  }

  /* Shows only the larger snapshot, cropped from the left so the first images line up, instead of cross-fading */
  :global(::view-transition-old(*.section-nav)),
  :global(::view-transition-new(*.section-nav)) {
    height: 100%;
    object-fit: cover;
    object-position: left top;
    animation: none;
    mix-blend-mode: normal;
  }

  :global(::view-transition-old(*.section-nav)),
  :global(
    :root:active-view-transition-type(section-nav-shrink)
      ::view-transition-new(*.section-nav)
  ) {
    opacity: 0;
  }

  :global(
    :root:active-view-transition-type(section-nav-shrink)
      ::view-transition-old(*.section-nav)
  ) {
    opacity: 1;
  }
</style>

---
type Props = {
  image: string;
  alt?: string;
  colSpan?: number;
  colStart?: number;
  alignSelf?: "start" | "center" | "end";
};

const { image, alt, colSpan, colStart, alignSelf } = Astro.props;
---

<img
  class="image"
  src={image}
  alt={alt ?? ""}
  style={{ gridColumn: `${colStart} / span ${colSpan}`, alignSelf }}
/>

<style>
  :global(.mode--image-only) {
    .image {
      grid-column: 1 / span 20 !important;
    }
  }
</style>

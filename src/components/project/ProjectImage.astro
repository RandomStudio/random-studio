---
type Props = {
  image: string;
  alt?: string;
  colSpan?: number;
  colStart?: number;
  alignSelf?: "start" | "center" | "end";
};

const { image, alt, colSpan, colStart, alignSelf } = Astro.props;
---

<img
  class="image"
  src={image}
  alt={alt ?? ""}
  data-slideshow-src={image}
  style={{ gridColumn: `${colStart} / span ${colSpan}`, alignSelf }}
/>

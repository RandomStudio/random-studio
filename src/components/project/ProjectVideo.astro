---
type Props = {
  src: string;
  colSpan?: number;
  colStart?: number;
  alignSelf?: "start" | "center" | "end";
};

const { src, colSpan, colStart, alignSelf } = Astro.props;
---

<video
  class="video"
  src={src}
  playsinline
  muted
  loop
  autoplay
  data-slideshow-src={src}
  style={{
    gridColumn: `${colStart} / span ${colSpan}`,
    alignSelf: alignSelf ?? "center",
  }}
></video>

<style>
  :global(.mode--text-only) {
    .video {
      display: none;
    }
  }
</style>

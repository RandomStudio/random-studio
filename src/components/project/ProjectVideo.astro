---
import { getSlideIndex, type Video } from "../../data/project";

type Props = {
  video: Video;
  colSpan?: number;
  colStart?: number;
  alignSelf?: "start" | "center" | "end";
};

const { video, colSpan, colStart, alignSelf } = Astro.props;
---

<video
  class="video"
  src={video.src}
  width={video.width}
  height={video.height}
  playsinline
  muted
  loop
  autoplay
  data-slideshow-index={getSlideIndex(video)}
  style={{
    gridColumn: `${colStart} / span ${colSpan}`,
    alignSelf: alignSelf ?? "center",
  }}
></video>

<style>
  :global(.mode--text-only) {
    .video {
      display: none;
    }
  }
</style>

---
import Constraint from "../layout/Constraint.astro";

type Props = {
  credits: string[][];
  collaborators: string[][];
};

const { credits, collaborators } = Astro.props;
---

<Constraint class="colophon">
  <div class="credits">
    <p class="heading">Credits</p>
    <dl>
      {
        credits.map(([name, value]) => (
          <>
            <dt>{name}</dt>
            <dd>{value}</dd>
          </>
        ))
      }
    </dl>
  </div>
  <div class="collaborators">
    <p class="heading">Collaborators</p>
    <dl>
      {
        collaborators.map(([name, value]) => (
          <>
            <dt>{name}</dt>
            <dd>{value}</dd>
          </>
        ))
      }
    </dl>
  </div>
</Constraint>

<style>
  .colophon {
    @mixin h3;
    display: grid;
    grid-template-columns: 4fr 3fr 8fr 5fr;
    grid-template-areas: "credits spacer collaborators spacer2";
    padding: 80px 0;

    .heading {
      margin-bottom: 1em;
    }
  }
  dl {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
  }
  dt,
  dd {
    width: 50%;
    margin-bottom: 0.3em;
  }
  .credits {
    grid-area: credits;
  }
  .collaborators {
    grid-area: collaborators;
  }

  :global(.mode--text-only) {
    .colophon {
      grid-template-columns: 5fr 4fr 2fr 4fr 5fr;
      grid-template-areas: "spacer3 credits spacer collaborators spacer2";
    }
  }
  :global(.mode--image-only) {
    .colophon {
      display: none;
    }
  }
</style>

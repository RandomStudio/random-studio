---
import Results from "./Results/Results.astro";
---

<search-form>
  <form class="search" role="search">
    <input
      aria-label="Search"
      autocomplete="off"
      class="input"
      name="q"
      placeholder="Type Here"
      type="text"
    />
    <button class="submit" disabled type="submit">
      Search
    </button>
  </form>
  <Results />
</search-form>

<script>
  import { createResultGroupElements } from "./Results/renderResults";
  import { loadSearchIndex, searchProjects } from "./searchIndex";
  import type { LoadedSearchIndex } from "./searchIndex";

  class SearchForm extends HTMLElement {
    #input!: HTMLInputElement;
    #submit!: HTMLButtonElement;
    #results!: HTMLElement;
    #controller?: AbortController;
    #searchIndex?: Promise<LoadedSearchIndex>;

    connectedCallback() {
      this.#input = this.querySelector(".input")!;
      this.#submit = this.querySelector(".submit")!;
      this.#results = this.querySelector(".results")!;

      this.#controller = new AbortController();
      const { signal } = this.#controller;

      this.#input.addEventListener("focus", this.#handleInputFocus, {
        signal,
      });
      this.#input.addEventListener("input", this.#handleInput, { signal });
      this.addEventListener("submit", this.#handleSubmit, { signal });
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }

    #getSearchIndex = () => (this.#searchIndex ??= loadSearchIndex());

    #handleInputFocus = () => {
      this.#getSearchIndex();
    };

    #handleInput = async () => {
      this.#submit.disabled = this.#input.value.trim() === "";

      const searchIndex = await this.#getSearchIndex();

      this.#results.replaceChildren(
        ...createResultGroupElements(
          searchProjects(searchIndex, this.#input.value),
        ),
      );
    };

    #handleSubmit = (event: Event) => {
      event.preventDefault();
    };
  }

  customElements.define("search-form", SearchForm);
</script>

<style>
  search-form:has(.input:placeholder-shown) :global(.results) {
    display: none;
  }

  .search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter);
    padding: var(--spacing-15) 15px;
  }

  .input {
    flex: 1;
    min-width: 0;
    height: 1lh;
    margin-block: calc((1cap - 1lh) / 2);
    padding: 0;
    border: 0;
    background: none;
    color: black;
    outline: none;

    &::placeholder {
      color: black;
    }
  }

  .submit {
    @mixin button-reset;
    color: black;
    text-box: trim-both cap alphabetic;
    transition: color var(--menu-transition);

    &:disabled {
      color: var(--color-link);
      cursor: default;
    }
  }
</style>

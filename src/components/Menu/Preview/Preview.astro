---
import PlaceholderImage from "../../PlaceholderImage/PlaceholderImage.astro";
import { categories } from "../menuCategories";
import { defaultCategoryId } from "../menuData";

const PREVIEW_IMAGE_WIDTH = 540;
---

<div class="preview">
  {categories.map((category) => (
    <PlaceholderImage
      alt=""
      class:list={[{ isActive: category.id === defaultCategoryId }]}
      data-category={category.id}
      src={category.image}
      width={PREVIEW_IMAGE_WIDTH}
    />
  ))}
</div>

<style>
  .preview {
    display: grid;
    aspect-ratio: 270 / 191;
  }

  img {
    grid-area: 1 / 1;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--menu-transition);

    &.isActive {
      opacity: 1;
    }
  }
</style>

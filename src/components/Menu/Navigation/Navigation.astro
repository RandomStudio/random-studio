---
import { categories, defaultCategoryId } from "../menuData";
---

<nav aria-label="Menu" class="navigation">
  <div class="row">
    <button class="item" data-action="search" type="button">
      Search
    </button>
    <button class="item" data-action="contact" type="button">
      Contact
    </button>
  </div>
  <div class="columns">
    <ul class="list">
      <li>
        <button class="item" data-action="work" type="button">
          Work
        </button>
      </li>
      <li>
        <span class="item">News</span>
      </li>
      <li>
        <a class="item" href="#">
          About
        </a>
      </li>
    </ul>
    <ul class="list categories">
      {categories.map((category) => (
        <li>
          <a
            class:list={[
              "item",
              { isActive: category.id === defaultCategoryId },
            ]}
            data-category={category.id}
            href="#"
          >
            {category.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .navigation {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-30);
    padding: var(--spacing-15) 15px;
  }

  .row {
    display: flex;
    justify-content: space-between;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gutter);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
  }

  .categories {
    @mixin fade-hidden var(--menu-transition);
  }

  .item {
    @mixin button-reset;
    font-size: 12px;
    line-height: 10px;
    display: block;
    color: black;
    white-space: nowrap;
    text-box: trim-both cap alphabetic;
    transition: color var(--menu-transition);
  }

  span.item {
    cursor: default;
  }

  .navigation[data-work] {
    .categories {
      @mixin fade-visible var(--menu-transition);
    }

    .item {
      color: var(--color-link);
    }

    .item:is([data-action="work"], .isActive, :hover) {
      color: black;
    }
  }
</style>

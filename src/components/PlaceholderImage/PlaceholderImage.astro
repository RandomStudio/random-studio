---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";

import { getImagePlaceholder } from "./getImagePlaceholder";

type OmitFromEachVariant<
  Variants,
  Key extends PropertyKey,
> = Variants extends unknown ? Omit<Variants, Key> : never;

type Props = OmitFromEachVariant<
  ComponentProps<typeof Image>,
  "src" | "style"
> & {
  src: ImageMetadata;
  style?: Record<string, string | undefined>;
};

const { src, style, ...imageProps } = Astro.props;

const placeholder = await getImagePlaceholder(src);
---

<Image
  src={src}
  {...imageProps}
  data-placeholder
  style={{
    ...style,
    backgroundImage: `url("${placeholder}")`,
    backgroundSize: "100% 100%",
  }}
/>

<script>
  const PLACEHOLDER_SELECTOR = "img[data-placeholder]";

  const getIsLoaded = (image: HTMLImageElement) =>
    image.complete && image.naturalWidth > 0;

  const markLoaded = (image: HTMLImageElement) => {
    image.dataset.loaded = "";
  };

  const handleLoad = ({ target }: Event) => {
    if (
      target instanceof HTMLImageElement &&
      target.matches(PLACEHOLDER_SELECTOR)
    ) {
      markLoaded(target);
    }
  };

  document.addEventListener("load", handleLoad, { capture: true });

  document
    .querySelectorAll<HTMLImageElement>(PLACEHOLDER_SELECTOR)
    .forEach((image) => {
      if (getIsLoaded(image)) markLoaded(image);
    });
</script>

<style>
  img[data-placeholder]:not([data-loaded]) {
    filter: blur(20px);
  }
</style>

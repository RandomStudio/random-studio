---
import "../styles/global.css";

import Constraint from "../components/layout/Constraint.astro";
import Menu from "../components/Menu/Menu.astro";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";

import Credits from "../components/project/Credits.astro";
import Content from "../components/project/Content.astro";
import Related from "../components/project/Related.astro";
import SectionNav from "../components/project/SectionNav.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href="/fonts/Oracle/ABCOracle-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Random Studio New Website mockup</title>
  </head>
  <body>
    <Nav client:load />
    <Menu client:load />
    <SectionNav />
    <main class="page">
      <Constraint client:load type="full" class="header">
        <p>Past and Future fabrics exhibition for Zara</p>
      </Constraint>
      <Content />
      <Credits
        credits={[
          ["For", "Zara"],
          ["Year", "2025"],
          ["Size", "100M2"],
          ["Location", "Galicia, ES"],
          ["Sector", "Fashion"],
        ]}
        collaborators={[
          ["Production", "Acierta"],
          ["Photography", "DSL Studio"],
        ]}
      />
      <Related />
      <Footer />
    </main>
  </body>

  <script>
    import { SECTION_NAV_SHRINK_TYPE } from "../components/project/sectionNavTransitionTypes";

    // Flags the body once content has scrolled fully over the header title,
    // which the nav title and section nav use to switch state together
    const HIDDEN_CLASS = "isProjectTitleHidden";

    const header = document.querySelector<HTMLElement>(".header");
    const title = header?.querySelector<HTMLElement>("p");

    if (header && title) {
      let frame: number | undefined;

      // The fixed title is clipped by the header, so hidden once the header ends above it
      const getIsHidden = () =>
        header.getBoundingClientRect().bottom <=
        title.getBoundingClientRect().top;

      const setIsHidden = (isHidden: boolean) => {
        document.body.classList.toggle(HIDDEN_CLASS, isHidden);
      };

      const update = () => {
        frame = undefined;
        const isHidden = getIsHidden();

        if (isHidden === document.body.classList.contains(HIDDEN_CLASS)) return;

        document.startViewTransition({
          update: () => setIsHidden(isHidden),
          types: isHidden ? [SECTION_NAV_SHRINK_TYPE] : [],
        });
      };

      const scheduleUpdate = () => {
        frame ??= requestAnimationFrame(update);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      setIsHidden(getIsHidden());
    } else {
      document.body.classList.add(HIDDEN_CLASS);
    }
  </script>
  <style>
    /* Keeps the page live during view transitions rather than a frozen snapshot */
    :global(:root) {
      view-transition-name: none;
    }

    :global(::view-transition) {
      pointer-events: none;
    }

    .page {
      transition: opacity var(--page-fade-duration);
    }

    :global(.isPageHidden) .page {
      opacity: 0;
      pointer-events: none;
    }

    :global(.mode--image-only) {
      overflow: hidden;
    }

    .header {
      position: relative;
      height: 88svh;
      /* Unlike overflow: hidden, clip-path also clips fixed-position children */
      clip-path: inset(0);

      p {
        @mixin h3;
        position: fixed;
        top: 50%;
        left: 50%;
        translate: -50% -50%;
        margin: 0;
      }

      > :global(img) {
        grid-column: 1;
        grid-row: 1;
        height: 100%;
        object-fit: cover;
        width: 100%;
      }
    }

    .mode--text-only {
      .header {
        height: 10svh;
      }
      :global(video) {
        display: none !important;
      }
      :global(img) {
        display: none !important;
      }
    }
  </style>
</html>

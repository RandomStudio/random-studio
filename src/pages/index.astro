---
import "../styles/global.css";

import Constraint from "../components/layout/Constraint.astro";
import Menu from "../components/layout/Menu.astro";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";

import Credits from "../components/project/Credits.astro";
import Content from "../components/project/Content.astro";
import Related from "../components/project/Related.astro";
import SectionNav from "../components/project/SectionNav.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href="/fonts/Oracle/ABCOracle-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Random Studio New Website mockup</title>
  </head>
  <body>
    <Nav client:load />
    <Menu client:load />
    <SectionNav />
    <Constraint client:load type="full" class="header">
      <p>Past and Future fabrics exhibition for Zara</p>
    </Constraint>
    <Content />
    <Credits
      credits={[
        ["For", "Zara"],
        ["Year", "2025"],
        ["Size", "100M2"],
        ["Location", "Galicia, ES"],
        ["Sector", "Fashion"],
      ]}
      collaborators={[
        ["Production", "Acierta"],
        ["Photography", "DSL Studio"],
      ]}
    />
    <Related />
    <Footer />
  </body>

  <script>
    // Flags the body once content has scrolled fully over the header title,
    // which the nav title and section nav use to switch state together
    const HIDDEN_CLASS = "isProjectTitleHidden";

    const header = document.querySelector<HTMLElement>(".header");
    const title = header?.querySelector<HTMLElement>("p");

    if (header && title) {
      let frame: number | undefined;

      const update = () => {
        frame = undefined;
        // The title is fixed and clipped by the header, so it is hidden once
        // the header's bottom edge passes above the title's top edge
        const isHidden =
          header.getBoundingClientRect().bottom <=
          title.getBoundingClientRect().top;

        document.body.classList.toggle(HIDDEN_CLASS, isHidden);
      };

      const scheduleUpdate = () => {
        frame ??= requestAnimationFrame(update);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      update();
    } else {
      document.body.classList.add(HIDDEN_CLASS);
    }
  </script>

  <style>
    .header {
      position: relative;
      height: 88svh;
      /* Unlike overflow: hidden, clip-path also clips fixed-position children */
      clip-path: inset(0);

      p {
        @mixin h3;
        position: fixed;
        top: 50%;
        left: 50%;
        translate: -50% -50%;
        margin: 0;
      }

      > :global(img) {
        grid-column: 1;
        grid-row: 1;
        height: 100%;
        object-fit: cover;
        width: 100%;
      }
    }

    .mode--text-only {
      .header {
        height: 10svh;
      }
      :global(video) {
        display: none !important;
      }
      :global(img) {
        display: none !important;
      }
    }
  </style>
</html>
